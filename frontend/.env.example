# ===================================================================
# SAKSHYATRAIL FRONTEND ENVIRONMENT CONFIGURATION (VERCEL)
# ===================================================================
# In production on Vercel, set VITE_API_BASE_URL to your Render backend URL.
# Examples:
#   https://sakshyatrail-api.onrender.com/api/v1
#   https://sakshyatrail-api.onrender.com
# The client automatically normalizes trailing slashes and the /api/v1 prefix.

VITE_API_BASE_URL=https://your-backend-name.onrender.com/api/v1

