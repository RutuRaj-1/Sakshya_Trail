# ===================================================================
# SAKSHYATRAIL / FDR SENTINEL - COMPREHENSIVE GITIGNORE
# Hardened to prevent sensitive files, credentials, local databases,
# scratch scripts, test dumps, and build caches from being pushed.
# ===================================================================

# --- 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL) ---
.env
.env.*
*.env
*.local
# Whitelist environment example templates for deployment reference:
!.env.example
!.env.*.example
!frontend/.env.example
!frontend/.env.*.example

# --- 2. FIREBASE, GOOGLE CLOUD & PRIVATE CREDENTIALS ---
# Prevents any Firebase Service Account or IAM credential leakage
*serviceAccount*.json
*service_account*.json
*serviceaccount*.json
*firebase-adminsdk*.json
sih-*.json
credentials*.json
client_secret*.json
token*.json
serviceAccountKey.json
backend/serviceAccountKey.json
google-credentials*.json
gcp-credentials*.json

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
id_rsa*
id_ed25519*

# --- 3. DATABASES & LOCAL STORAGE VOLUMES ---
# SQLite files, write-ahead logs, and snapshots
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
fdr_sentinel.db
fdr_sentinel_demo.db
backend/fdr_sentinel*.db

# Document storage directories & uploaded artifacts
storage/
backend/storage/
data/
uploads/
downloads/

# --- 4. SCRATCH SCRIPTS & TEST OUTPUT DUMPS ---
# Local helper scripts and temporary workspace
scratch/
*/scratch/
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Test execution logs & private terminal output dumps
*test_results*.txt
prompt*_test_results.txt
test_results.txt
backend/*test_results*.txt

# --- 5. PYTHON / VIRTUAL ENVIRONMENTS & CACHES ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
backend/venv/
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage tooling
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# --- 6. FRONTEND / NODE / VITE / VERCEL ---
node_modules/
*/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
frontend/coverage/
dist/
dist-ssr/
.turbo/
.output/
*.tsbuildinfo
vite.config.ts.timestamp-*

# Cloud deployment CLI metadata
.vercel/
.render/

# Package manager logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 7. IDE & OPERATING SYSTEM ARTIFACTS ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.code-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
