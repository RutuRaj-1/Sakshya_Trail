# ==============================================================================
# FDR Sentinel / SakshyaTrail — Master Environment Configuration Template
# SIH 2026 Problem Statement 26265
# ==============================================================================
# Copy this file to .env (or backend/.env) for local development.
# Do NOT commit actual secrets, private keys, or service account files.

# --- 1. APPLICATION GENERAL ---
ENVIRONMENT=development
PROJECT_NAME="SakshyaTrail"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DEBUG=True

# --- 2. BACKEND SERVER & CORS ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://*.vercel.app"]

# --- 3. DATABASE CONFIGURATION ---
# Demo mode uses SQLite demo database (20 institutions, 80 FDR instruments)
SAKSHYATRAIL_DEMO_MODE=true
SAKSHYATRAIL_DEMO_DATABASE_URL=sqlite:///./fdr_sentinel_demo.db
DATABASE_URL=sqlite:///./fdr_sentinel.db
# For PostgreSQL in staging/production:
# DATABASE_URL=postgresql+psycopg://fdr_user:fdr_password@localhost:5432/fdr_sentinel

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# --- 4. FRONTEND VITE CONFIGURATION ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="SakshyaTrail"
VITE_ENVIRONMENT=development

# --- 5. FIREBASE WEB CLIENT CREDENTIALS (SIH 26265) ---
VITE_FIREBASE_API_KEY=AIzaSyAqqvkCHZutYjILCXT6Q-SzvGn88holAps
VITE_FIREBASE_AUTH_DOMAIN=sih-26265-fdr.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sih-26265-fdr
VITE_FIREBASE_STORAGE_BUCKET=sih-26265-fdr.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=2017740195
VITE_FIREBASE_APP_ID=1:2017740195:web:ed1355f7fd21cd3ad80616
VITE_FIREBASE_MEASUREMENT_ID=G-YYNCY2BVT9

# --- 6. FIREBASE STORAGE BACKEND (FASTAPI SERVER-SIDE) ---
# DOCUMENT_STORAGE_BACKEND: "local" or "firebase"
DOCUMENT_STORAGE_BACKEND=firebase
FIREBASE_STORAGE_ENABLED=true
FIREBASE_PROJECT_ID=sih-26265-fdr
FIREBASE_STORAGE_BUCKET=sih-26265-fdr.firebasestorage.app
FIREBASE_API_KEY=AIzaSyAqqvkCHZutYjILCXT6Q-SzvGn88holAps
