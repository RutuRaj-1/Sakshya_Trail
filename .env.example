# ==============================================================================
# FDR Sentinel / SakshyaTrail — Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env for local overrides.
# Do NOT commit actual secrets, private keys, or service account files.

# Application General
ENVIRONMENT=development
PROJECT_NAME="SakshyaTrail"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (SQLite for local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./fdr_sentinel.db
# DATABASE_URL=postgresql+psycopg://fdr_user:fdr_password@localhost:5432/fdr_sentinel

# SakshyaTrail Demo Mode
SAKSHYATRAIL_DEMO_MODE=true
SAKSHYATRAIL_DEMO_DATABASE_URL=sqlite:///./fdr_sentinel_demo.db

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# ==============================================================================
# Document Storage Backend
# ==============================================================================
# DOCUMENT_STORAGE_BACKEND: "local" (default) or "firebase"
# Set to "firebase" to store document bytes in Firebase / Google Cloud Storage.
# When "firebase" is selected, FIREBASE_STORAGE_ENABLED must also be true and
# GOOGLE_APPLICATION_CREDENTIALS must point to a valid service account JSON.
DOCUMENT_STORAGE_BACKEND=local

# Set true only when DOCUMENT_STORAGE_BACKEND=firebase
FIREBASE_STORAGE_ENABLED=false

# Firebase Project Configuration (web-safe, not privileged)
FIREBASE_PROJECT_ID=sih-26265-fdr
FIREBASE_STORAGE_BUCKET=sih-26265-fdr.firebasestorage.app

# Path to your Firebase/GCP service-account JSON key.
# IMPORTANT:
#   - Never commit this file. It is already in .gitignore.
#   - Generate from: Firebase Console → Project Settings → Service Accounts
#     → Generate new private key → save as backend/serviceAccountKey.json
#   - On GCP / Firebase Hosting, omit this and use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ==============================================================================
# External Integration Architecture & Gateways (Prompt 2)
# ==============================================================================
# INTEGRATION_MODE: "mock" (default demo/testing) | "sandbox" (authorized testbed) | "production"
INTEGRATION_MODE=mock

# AICTE Approval & Institutional Registry Integration
AICTE_INTEGRATION_ENABLED=false
AICTE_API_BASE_URL=https://api.aicte-india.org/sandbox/v1
AICTE_API_KEY=placeholder-aicte-api-key
AICTE_CLIENT_ID=placeholder-aicte-client-id
AICTE_CLIENT_SECRET=placeholder-aicte-client-secret

# Core Banking Network / Bank Gateway FDR Verification Integration
BANK_VERIFICATION_ENABLED=false
LIVE_BANK_ADAPTER_ENABLED=false
BANK_GATEWAY_BASE_URL=https://gateway.banking-network.org/sandbox/v1
BANK_GATEWAY_API_KEY=placeholder-bank-gateway-api-key
BANK_GATEWAY_CLIENT_CERT_PATH=

# Integration Transport & Reliability Controls
INTEGRATION_TIMEOUT_SECONDS=15
INTEGRATION_MAX_RETRIES=3
INTEGRATION_RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# Frontend Environment Variables (Vite reads VITE_ prefix)
# ==============================================================================
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="SakshyaTrail"
VITE_ENVIRONMENT=development
