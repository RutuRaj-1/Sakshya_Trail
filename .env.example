# ==============================================================================
# FDR Sentinel — Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env or backend/.env / frontend/.env for local overrides.
# Do NOT commit production secrets to version control.

# Application General
ENVIRONMENT=development
PROJECT_NAME="FDR Sentinel"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
DEBUG=True

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (PostgreSQL / SQLite fallback for quick local testing)
# For local SQLite development (zero extra setup):
DATABASE_URL=sqlite:///./fdr_sentinel.db
# For PostgreSQL (Production / Staging / Local Dockerless Postgres service):
# DATABASE_URL=postgresql+psycopg://fdr_user:fdr_password@localhost:5432/fdr_sentinel

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# Firebase / Optional Cloud Adapter Placeholder (if configured)
FIREBASE_PROJECT_ID=fdr-sentinel-dev
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=fdr-sentinel-storage

# Frontend Environment Variables (Vite reads from VITE_ prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="FDR Sentinel"
VITE_ENVIRONMENT=development
